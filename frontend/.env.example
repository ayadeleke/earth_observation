# React Frontend Environment Variables
# Inlined at build time: on Vercel, set these in Project Settings > Environment Variables.

# Versioned API root, e.g. https://your-api.onrender.com/api/v1
REACT_APP_API_URL=http://127.0.0.1:8000/api/v1
# Optional server root for /static/ map files; derived from REACT_APP_API_URL when unset
REACT_APP_BACKEND_URL=
REACT_APP_EARTH_ENGINE_SIGNUP_URL=https://signup.earthengine.google.com/
REACT_APP_DEMO_MODE=true

# Google OAuth Configuration
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
