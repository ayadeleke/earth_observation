# Django Backend Environment Variables
# Copy to .env for local development. On Render, set these in the service's Environment tab.
# Never commit real values.

# --- Core ---
DEBUG=True
# Required when DEBUG=False (startup fails with the insecure default)
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
# Set automatically by Render; appended to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS
# RENDER_EXTERNAL_HOSTNAME=
# Render only: pin a full 3.10.x version if backend/.python-version is not picked up
# PYTHON_VERSION=
LOG_LEVEL=INFO

# --- Database ---
# Leave empty to use SQLite (db.sqlite3). Format: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
# Postgres SSL mode: disable | allow | prefer | require | verify-ca | verify-full
DB_SSLMODE=require
DB_CONN_MAX_AGE=600

# --- CORS / CSRF ---
# Frontend origins, e.g. https://your-app.vercel.app (also used for CSP frame-ancestors)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Cache ---
# Leave empty to use in-process LocMemCache and database-backed sessions
REDIS_URL=

# --- Static / media storage ---
USE_AZURE_STORAGE=False
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
AZURE_CONTAINER=media
AZURE_STATIC_CONTAINER=static
AZURE_CUSTOM_DOMAIN=

# --- Earth Engine ---
EARTH_ENGINE_PROJECT=
# Service account JSON key, base64-encoded on one line (preferred on Render)
EARTH_ENGINE_SERVICE_ACCOUNT_KEY_BASE64=
# Alternative: a path to the JSON key file, or the raw JSON itself
EARTH_ENGINE_SERVICE_ACCOUNT_KEY=
# Defaults to True when EARTH_ENGINE_SERVICE_ACCOUNT_KEY_BASE64 is set
EARTH_ENGINE_USE_SERVICE_ACCOUNT=
EARTH_ENGINE_USE_APP_DEFAULT=True

# --- AI Assistant (Gemini) ---
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_ASSISTANT_ENABLED=True
AI_ASSISTANT_MAX_TOKENS=5000
AI_ASSISTANT_TEMPERATURE=0.7
AI_ASSISTANT_MODEL=gemini-2.5-flash

# --- Email (Brevo HTTP API via django-anymail) ---
# auto = console when DEBUG, Brevo otherwise | brevo | console
EMAIL_BACKEND=auto
BREVO_API_KEY=
# Must be a sender verified in Brevo
DEFAULT_FROM_EMAIL=
# Used to build password reset links
FRONTEND_URL=http://localhost:3000

# --- Generated maps and background analyses ---
# Project URL and secret key; maps stay on local disk when unset. The key bypasses RLS, so keep it server-side.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_MAPS_BUCKET=maps
# Analyses and maps running at once. Keep 1 on 512 MB; each needs over 100 MB on top of the app.
ANALYSIS_CONCURRENCY=1
# Longest a single Earth Engine request may run
EE_REQUEST_TIMEOUT_SECONDS=120
PASSWORD_RESET_TIMEOUT=7200
